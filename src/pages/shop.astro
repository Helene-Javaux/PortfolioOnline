---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PrintCard from '../components/PrintCard.astro';
import PrintOrderDialog from '../components/PrintOrderDialog.astro';
import { photo } from '../lib/photos';
import { url } from '../lib/url';

const prints = (await getCollection('prints'))
  .filter((print) => print.data.available)
  .sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
  title="Shop — Tirages d'art"
  description="Tirages d'art de Hélène Javaux, imprimés avec soin en édition ouverte. Commande par simple demande, sans paiement en ligne."
>
  <header class="container page-header">
    <p class="kicker">Shop</p>
    <h1>Des tirages faits pour durer</h1>
    <p>
      Une sélection d'images issues de mes séries, imprimées avec soin sur
      papier de qualité. Pas de panier ni de paiement en ligne : clique sur
      « Demander ce tirage », je te réponds personnellement pour finaliser la
      commande (virement, remise en main propre à Bruxelles ou envoi postal).
    </p>
  </header>

  <section class="container">
    <div class="shop-grid">
      {
        prints.map((print, i) => (
          <div data-reveal style={`--reveal-delay: ${(i % 3) * 0.1}s`}>
            <PrintCard
              title={print.data.title}
              reference={print.data.reference}
              description={print.data.description}
              photoImage={photo(print.data.photo)}
              formats={print.data.formats}
            />
          </div>
        ))
      }
    </div>
  </section>

  <section class="cta-band">
    <div class="container" data-reveal>
      <p class="kicker kicker--center kicker--on-dark">Hors catalogue</p>
      <h2>Un format ou un tirage différent ?</h2>
      <p>
        Toutes mes images peuvent être tirées, dans le format que tu veux.
        Écris-moi et on trouve la formule qui te convient.
      </p>
      <a href={url('/contact/')} class="btn btn--light">Me contacter</a>
    </div>
  </section>

  <PrintOrderDialog />
</BaseLayout>

<style>
  .shop-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(17rem, 1fr));
    gap: 1.5rem;
  }
</style>
