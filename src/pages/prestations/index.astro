---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { galleryFeatured } from '../../lib/photos';
import { devisUrl, url } from '../../lib/url';

const services = (await getCollection('services')).sort(
  (a, b) => a.data.order - b.data.order,
);
const tarifs = (await getCollection('tarifs')).sort(
  (a, b) => a.data.order - b.data.order,
);

// Associe chaque carte tarif à sa galerie de service (même slug, comme sur
// la landing page /prestations/<slug>/ ; à défaut correspondance par titre)
const serviceFor = (id: string, title: string) =>
  services.find((s) => s.id === id) ??
  services.find((s) => s.data.title.toLowerCase() === title.toLowerCase());
---

<Layout
  title="Prestations & tarifs"
  ogPhoto={services[0] && galleryFeatured('services', services[0].id, services[0].data.cover, services[0].data.featured)[0]}
  ogPosition={services[0]?.data.ogPosition}
  description="Prestations photo de Hélène Javaux : portrait, sport, packshot, événementiel. Tarifs transparents, devis sous 24 h."
>
  <header class="container xpage-head">
    <p class="exp-label">Prestations</p>
    <h1>Ce que je peux <em>créer pour vous</em></h1>
    <p class="xpage-head__intro">
      Portrait animalier, sport, produits, événements : chaque prestation commence par
      une conversation et se termine par des images qui vous ressemblent. Les
      tarifs sont indicatifs : le devis précis est toujours gratuit et sans
      engagement.
    </p>
    <hr class="exp-rule" />
  </header>

  <section class="container xprestations">
    {
      tarifs.map((tarif, i) => {
        const service = serviceFor(tarif.id, tarif.data.title);
        const wall = service
          ? galleryFeatured('services', service.id, service.data.cover, service.data.featured)
          : [];
        const hasPackages = Boolean(tarif.data.packages?.length);

        return (
          <article class="xprestation" data-reveal style={`--reveal-delay: ${(i % 2) * 0.1}s`}>
            {service && (
              <div class="xprestation__media">
                <a
                  href={url(`/prestations/${service.id}/`)}
                  class="xprestation__wall"
                  aria-label={`Voir les exemples — ${service.data.title}`}
                >
                  {wall.map((image, j) => (
                    <Image
                      src={image}
                      alt={`Exemple ${j + 1} — ${service.data.title}`}
                      width={j === 0 ? 900 : 500}
                      widths={j === 0 ? [450, 900] : [300, 500]}
                      sizes={j === 0 ? '(max-width: 48rem) 60vw, 28vw' : '(max-width: 48rem) 40vw, 18vw'}
                      loading="lazy"
                      style={j === 0 && service.data.coverPosition && !service.data.featured?.length
                        ? `object-position: ${service.data.coverPosition};`
                        : undefined}
                    />
                  ))}
                </a>
                <a href={url(`/prestations/${service.id}/`)} class="exp-arrow-link xprestation__more">
                  Voir plus d'exemples <span aria-hidden="true">→</span>
                </a>
              </div>
            )}
            <div class="xprestation__body">
              <h2>{tarif.data.title}</h2>
              {tarif.data.subtitle && <p class="xprestation__subtitle">{tarif.data.subtitle}</p>}

              {
                hasPackages ? (
                  <dl class="xprestation__prices">
                    <div>
                      <dt>À partir de</dt>
                      <dd>{tarif.data.packages![0].price}</dd>
                    </div>
                  </dl>
                ) : (
                  <>
                    <dl class="xprestation__prices">
                      <div>
                        <dt>Demi-journée</dt>
                        <dd>{tarif.data.halfDay}</dd>
                      </div>
                      <div>
                        <dt>Journée</dt>
                        <dd>{tarif.data.fullDay}</dd>
                      </div>
                    </dl>

                    <ul class="xprestation__includes">
                      {tarif.data.includes.map((item) => (
                        <li>{item}</li>
                      ))}
                    </ul>
                  </>
                )
              }

              {tarif.data.notes && (
                <ul class="xprestation__notes">
                  {tarif.data.notes.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
              )}

              {tarif.data.note && <p class="xprestation__note">{tarif.data.note}</p>}

              <div class="xprestation__cta">
                <a href={devisUrl(service?.data.contactType)} class="xbtn xbtn--ghost xbtn--sm">
                  Demander un devis
                </a>
                <p class="xprestation__reassure">Gratuit, sans engagement — réponse sous 24 h.</p>
              </div>
            </div>
          </article>
        );
      })
    }
  </section>

  <section class="container xprestations-infos" data-reveal>
    <p>
      Déplacements offerts dans un rayon de 30 km autour de Bruxelles
      (0,45 €/km au-delà). Toutes les photos sont retouchées, livrées en haute
      définition via une galerie privée, et un acompte de 30 % réserve votre
      date. Je ne suis pas assujettie à la TVA : les prix affichés sont
      les prix finaux.
    </p>
    <a href={url('/contact/')} class="xbtn">Un devis en 24 h</a>
  </section>
</Layout>

<style>
  .xpage-head {
    padding-block: clamp(7rem, 16vw, 10rem) 0;
  }

  .xpage-head__intro {
    color: var(--exp-muted);
    max-width: 42rem;
  }

  .xpage-head h1 em {
    color: var(--exp-accent);
  }

  .xprestations {
    display: flex;
    flex-direction: column;
    gap: clamp(3rem, 7vw, 5rem);
  }

  .xprestation {
    display: grid;
    grid-template-columns: minmax(0, 0.92fr) minmax(0, 1fr);
    gap: clamp(1.75rem, 4vw, 3.5rem);
    align-items: center;
  }

  .xprestation:nth-child(2n) .xprestation__media {
    order: 2;
  }

  .xprestation__media {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
    width: 100%;
    max-width: 36rem;
  }

  /* Gallery wall : une grande photo + deux plus petites empilées */
  .xprestation__wall {
    display: grid;
    grid-template-columns: 1.45fr 1fr;
    grid-template-rows: 1fr 1fr;
    gap: clamp(0.5rem, 1.2vw, 0.85rem);
    aspect-ratio: 5 / 4.6;
    max-height: min(68vh, 34rem);
  }

  .xprestation__wall img {
    width: 100%;
    height: 100%;
    min-height: 0;
    object-fit: cover;
    transition: transform 0.6s ease, opacity 0.4s ease;
  }

  .xprestation__wall img:first-child {
    grid-row: 1 / span 2;
  }

  .xprestation__wall:hover img {
    opacity: 0.9;
  }

  .xprestation__more {
    align-self: flex-start;
    margin-top: 0.6rem;
  }

  /* Miroir : grande photo à droite quand le texte est à gauche */
  .xprestation:nth-child(2n) .xprestation__wall {
    grid-template-columns: 1fr 1.45fr;
  }

  .xprestation:nth-child(2n) .xprestation__wall img:first-child {
    grid-column: 2;
  }

  .xprestation:nth-child(2n) .xprestation__more {
    align-self: flex-end;
  }

  .xprestation__cta {
    margin-top: 0.5rem;
  }

  .xprestation__cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem 1.25rem;
  }

  .xprestation__reassure {
    margin: 0;
    font-size: 0.8rem;
    color: var(--exp-muted);
  }

  .xprestation__body h2 {
    font-size: clamp(1.7rem, 3.2vw, 2.3rem);
    margin-bottom: 0.1em;
  }

  .xprestation__subtitle {
    font-size: 0.8rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--exp-muted);
    margin-bottom: 1.25rem;
  }

  .xprestation__prices {
    display: flex;
    gap: 2.5rem;
    margin: 0 0 1.25rem;
    padding-block: 1rem;
    border-block: 1px solid var(--exp-line);
  }

  .xprestation__prices dt {
    font-size: 0.72rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--exp-muted);
  }

  .xprestation__prices dd {
    margin: 0.15rem 0 0;
    font-family: var(--font-display);
    font-size: 1.7rem;
    color: var(--exp-accent);
  }

  .xprestation__includes {
    list-style: none;
    margin: 0 0 1.25rem;
    padding: 0;
  }


  .xprestation__includes li,
  .xprestation__notes li {
    position: relative;
    padding-left: 1.5rem;
    margin-bottom: 0.45rem;
    font-size: 0.93rem;
    color: var(--exp-text);
  }

  .xprestation__includes li::before,
  .xprestation__notes li::before {
    content: '—';
    position: absolute;
    left: 0;
    color: var(--exp-accent);
  }

  .xprestation__notes {
    list-style: none;
    margin: 0 0 1.25rem;
    padding: 0;
  }

  .xprestation__note {
    font-style: italic;
    font-size: 0.85rem;
    color: var(--exp-muted);
    margin-bottom: 1.5rem;
  }

  .xprestations-infos {
    margin-top: clamp(3.5rem, 8vw, 5.5rem);
    padding: clamp(2rem, 5vw, 3.5rem);
    border: 1px solid var(--exp-line);
    background: var(--exp-surface);
    text-align: center;
  }

  .xprestations-infos p {
    color: var(--exp-muted);
    max-width: 44rem;
    margin: 0 auto 1.75rem;
  }

  @media (max-width: 48rem) {
    .xprestation,
    .xprestation:nth-child(2n) {
      grid-template-columns: 1fr;
    }

    .xprestation:nth-child(2n) .xprestation__media {
      order: 0;
    }

    .xprestation__media {
      max-width: 100%;
    }

    .xprestation__wall {
      max-height: none;
    }

    .xprestation:nth-child(2n) .xprestation__wall {
      grid-template-columns: 1.45fr 1fr;
    }

    .xprestation:nth-child(2n) .xprestation__wall img:first-child {
      grid-column: 1;
    }

    .xprestation:nth-child(2n) .xprestation__more {
      align-self: flex-start;
    }
  }
</style>