---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import PhotoGrid from '../../components/PhotoGrid.astro';
import Lightbox from '../../components/Lightbox.astro';
import { galleryPhotos } from '../../lib/photos';
import { url } from '../../lib/url';

export async function getStaticPaths() {
  const services = await getCollection('services');
  return services.map((service) => ({
    params: { slug: service.id },
    props: { service },
  }));
}

const { service } = Astro.props;
const photos = galleryPhotos('services', service.id);

// Carte tarifaire associée (même slug que la galerie de service)
const tarif = (await getCollection('tarifs')).find((t) => t.id === service.id);

// Série de la galerie dont le regard est proche (déclarée dans le YAML)
const related = service.data.relatedProject
  ? (await getCollection('projects')).find((p) => p.id === service.data.relatedProject)
  : undefined;

// Autres prestations pour poursuivre la visite
const others = (await getCollection('services'))
  .filter((s) => s.id !== service.id)
  .sort((a, b) => a.data.order - b.data.order);
---

<Layout
  title={`${service.data.title} — Prestation`}
  description={`Prestation ${service.data.title.toLowerCase()} par Hélène Javaux, photographe à Bruxelles${tarif?.data.packages?.[0] ? ` — à partir de ${tarif.data.packages[0].price}` : tarif ? ` — à partir de ${tarif.data.halfDay}` : ''}. Exemples, tarifs et devis gratuit sous 24 h.`}
>
  <header class="container xpage-head">
    <p class="exp-label">Prestation</p>
    <h1>{service.data.title}</h1>
    {service.data.description && <p class="xpage-head__intro">{service.data.description}</p>}
    <hr class="exp-rule" />
  </header>

  <div class="container xservice">
    <div class="xservice__gallery">
      <PhotoGrid photos={photos} altPrefix={service.data.title} />
    </div>

    <aside class="xservice__panel">
      {
        tarif && (
          <div class="xservice__pricing">
            <p class="exp-label">Tarifs</p>
            {tarif.data.subtitle && <p class="xservice__sub">{tarif.data.subtitle}</p>}

            {
              tarif.data.packages?.length ? (
                <div class="xservice__packages">
                  {tarif.data.packages.map((pack) => (
                    <section class="xservice__package">
                      <header class="xservice__package-head">
                        <h3>{pack.title}</h3>
                        <p>{pack.price}</p>
                      </header>
                      <ul class="xservice__includes xservice__includes--compact">
                        {pack.details.map((item) => (
                          <li>{item}</li>
                        ))}
                      </ul>
                    </section>
                  ))}
                </div>
              ) : (
                <>
                  <dl class="xservice__prices">
                    <div>
                      <dt>Demi-journée</dt>
                      <dd>{tarif.data.halfDay}</dd>
                    </div>
                    <div>
                      <dt>Journée</dt>
                      <dd>{tarif.data.fullDay}</dd>
                    </div>
                  </dl>

                  <ul class="xservice__includes">
                    {tarif.data.includes.map((item) => (
                      <li>{item}</li>
                    ))}
                  </ul>
                </>
              )
            }

            {tarif.data.notes && (
              <ul class="xservice__notes">
                {tarif.data.notes.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            )}

            {tarif.data.note && <p class="xservice__note">{tarif.data.note}</p>}

            <a href={url('/contact/')} class="xbtn xservice__cta">
              Demander un devis
            </a>
            <p class="xservice__reassure">Gratuit, sans engagement — réponse sous 24 h.</p>
          </div>
        )
      }
    </aside>
  </div>

  <section class="container xservice-others" data-reveal>
    <p class="exp-label">Autres prestations</p>
    <div class="xservice-others__list">
      {
        others.map((other) => (
          <a href={url(`/prestations/${other.id}/`)} class="exp-arrow-link">
            {other.data.title} <span aria-hidden="true">→</span>
          </a>
        ))
      }
    </div>
  </section>

  <Lightbox />
</Layout>

<style>
  .xpage-head {
    padding-block: clamp(7rem, 16vw, 10rem) 0;
  }

  .xpage-head__intro {
    color: var(--exp-muted);
    max-width: 44rem;
  }

  .xservice {
    display: grid;
    grid-template-columns: minmax(0, 13fr) minmax(0, 6fr);
    gap: clamp(2rem, 4.5vw, 4rem);
    align-items: start;
  }

  .xservice__panel {
    position: sticky;
    top: 6rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .xservice__pricing {
    border: 1px solid var(--exp-line);
    background: var(--exp-surface);
    padding: 1.75rem;
  }

  .xservice__sub {
    font-size: 0.85rem;
    color: var(--exp-muted);
    margin-bottom: 1rem;
  }

  .xservice__prices {
    display: flex;
    gap: 2rem;
    margin: 0 0 1.25rem;
    padding-block: 1rem;
    border-block: 1px solid var(--exp-line);
  }

  .xservice__prices dt {
    font-size: 0.7rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--exp-muted);
  }

  .xservice__prices dd {
    margin: 0.15rem 0 0;
    font-family: var(--font-display);
    font-size: 1.6rem;
    color: var(--exp-accent);
  }

  .xservice__packages {
    display: grid;
    gap: 1rem;
    margin-bottom: 1.25rem;
  }

  .xservice__package {
    padding: 1rem 0;
    border-block: 1px solid var(--exp-line);
  }

  .xservice__package + .xservice__package {
    margin-top: -1px;
  }

  .xservice__package-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    margin-bottom: 0.85rem;
  }

  .xservice__package-head h3 {
    margin: 0;
    font-size: 1.05rem;
  }

  .xservice__package-head p {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.45rem;
    color: var(--exp-accent);
    white-space: nowrap;
  }

  .xservice__includes {
    list-style: none;
    margin: 0 0 1.25rem;
    padding: 0;
  }

  .xservice__includes--compact {
    margin-bottom: 0;
  }

  .xservice__includes li,
  .xservice__notes li {
    position: relative;
    padding-left: 1.5rem;
    margin-bottom: 0.45rem;
    font-size: 0.9rem;
  }

  .xservice__includes li::before,
  .xservice__notes li::before {
    content: '—';
    position: absolute;
    left: 0;
    color: var(--exp-accent);
  }

  .xservice__notes {
    list-style: none;
    margin: 0 0 1.25rem;
    padding: 0;
  }

  .xservice__note {
    font-style: italic;
    font-size: 0.82rem;
    color: var(--exp-muted);
    margin-bottom: 1.25rem;
  }

  .xservice__cta {
    display: block;
    width: 100%;
    text-align: center;
  }

  .xservice__reassure {
    margin: 0.85rem 0 0;
    font-size: 0.8rem;
    color: var(--exp-muted);
    text-align: center;
  }

  .xservice-others {
    margin-top: clamp(3.5rem, 8vw, 5.5rem);
    padding-top: 2.5rem;
    border-top: 1px solid var(--exp-line);
  }

  .xservice-others__list {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem 2.5rem;
  }

  @media (max-width: 56rem) {
    .xservice {
      grid-template-columns: 1fr;
    }

    .xservice__panel {
      position: static;
    }

    .xservice__package-head {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>