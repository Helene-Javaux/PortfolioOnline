---
/**
 * Fenêtre de demande de tirage — envoi via Web3Forms, clé SÉPARÉE du
 * formulaire de contact. À inclure UNE fois sur la page Shop.
 * La référence du tirage cliqué est injectée automatiquement.
 *
 * ⚠️ La clé d'accès se configure dans src/config.ts (WEB3FORMS_PRINTS_KEY).
 */
import { WEB3FORMS_PRINTS_KEY } from '../config';
---

<dialog class="print-dialog" id="print-dialog">
  <button class="print-dialog__close" type="button" aria-label="Fermer" data-dialog-close>×</button>

  <h2 class="print-dialog__title">Demander un tirage</h2>
  <p class="print-dialog__ref">
    Tirage : <strong id="pd-print-label"></strong>
  </p>

  <form id="print-form" novalidate>
    <!-- Clé d'accès Web3Forms dédiée au shop (placeholder à remplacer dans src/config.ts) -->
    <input type="hidden" name="access_key" value={WEB3FORMS_PRINTS_KEY} />
    <input type="hidden" name="subject" value="Demande de tirage via helenejavaux.be" />
    <input type="hidden" name="from_name" value="Shop helenejavaux.be" />
    <!-- Référence pré-remplie automatiquement au clic sur « Demander ce tirage » -->
    <input type="hidden" name="reference_tirage" id="pd-reference" value="" />
    <!-- Anti-spam (honeypot Web3Forms) -->
    <input type="checkbox" name="botcheck" class="visually-hidden" tabindex="-1" autocomplete="off" />

    <div class="field">
      <label for="pd-name">Nom</label>
      <input id="pd-name" type="text" name="name" required autocomplete="name" />
    </div>

    <div class="field">
      <label for="pd-email">E-mail</label>
      <input id="pd-email" type="email" name="email" required autocomplete="email" />
    </div>

    <div class="field">
      <label for="pd-format">Format souhaité</label>
      <select id="pd-format" name="format_souhaite" required></select>
    </div>

    <div class="field">
      <label for="pd-message">Message (optionnel)</label>
      <textarea id="pd-message" name="message" rows="4"></textarea>
    </div>

    <button class="btn" type="submit">Envoyer la demande</button>
    <p class="form-status" role="status" aria-live="polite"></p>
  </form>
</dialog>

<style>
  .print-dialog {
    width: min(92vw, 32rem);
    border: 1px solid var(--color-line);
    padding: 2rem;
    margin: auto;
  }

  .print-dialog::backdrop {
    background: rgba(12, 12, 12, 0.55);
  }

  .print-dialog__close {
    position: absolute;
    top: 0.5rem;
    right: 0.75rem;
    background: none;
    border: none;
    font-size: 1.75rem;
    cursor: pointer;
    color: var(--color-muted);
  }

  .print-dialog__title {
    margin-bottom: 0.25rem;
  }

  .print-dialog__ref {
    color: var(--color-muted);
    margin-bottom: 1.5rem;
  }
</style>

<script>
  import { bindWeb3Form } from '../lib/web3form';

  const dialog = document.getElementById('print-dialog') as HTMLDialogElement | null;
  const form = document.getElementById('print-form') as HTMLFormElement | null;
  const label = document.getElementById('pd-print-label');
  const referenceInput = document.getElementById('pd-reference') as HTMLInputElement | null;
  const formatSelect = document.getElementById('pd-format') as HTMLSelectElement | null;

  bindWeb3Form(form);

  document.querySelectorAll<HTMLButtonElement>('[data-print-request]').forEach((button) => {
    button.addEventListener('click', () => {
      const { reference = '', title = '', formats = '[]' } = button.dataset;

      if (label) label.textContent = `${title} (réf. ${reference})`;
      if (referenceInput) referenceInput.value = `${title} — ${reference}`;
      if (formatSelect) {
        formatSelect.innerHTML = '';
        for (const formatLabel of JSON.parse(formats) as string[]) {
          formatSelect.add(new Option(formatLabel));
        }
      }
      form?.querySelector<HTMLElement>('.form-status')?.removeAttribute('data-state');
      dialog?.showModal();
    });
  });

  dialog?.querySelector('[data-dialog-close]')?.addEventListener('click', () => dialog.close());

  // Clic sur le fond → fermer
  dialog?.addEventListener('click', (event) => {
    if (event.target === dialog) dialog.close();
  });
</script>
