---
import { Image } from 'astro:assets';
import logo from '../assets/logo.svg';
import { url } from '../lib/url';

const links = [
  { href: url('/portfolio/'), label: 'Portfolio' },
  { href: url('/a-propos/'), label: 'À propos' },
  { href: url('/tarifs/'), label: 'Tarifs' },
  { href: url('/shop/'), label: 'Shop' },
  { href: url('/contact/'), label: 'Contact' },
];

const current = Astro.url.pathname;
---

<header class="site-header">
  <div class="container header-inner">
    <a href={url('/')} class="logo-link" aria-label="Accueil — Hélène Javaux">
      <Image src={logo} alt="Hélène Javaux" height={46} />
    </a>

    <button
      class="nav-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="site-nav"
      aria-label="Ouvrir le menu"
    >
      <span></span><span></span><span></span>
    </button>

    <nav id="site-nav" class="site-nav" aria-label="Navigation principale">
      {
        links.map((link) => (
          <a
            href={link.href}
            aria-current={current.startsWith(link.href) ? 'page' : undefined}
          >
            {link.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>

<style>
  /* Bande sombre héritée de l'identité du site : logo clair, liens clairs */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--color-dark);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 0.6rem;
  }

  .logo-link img {
    height: 46px;
    width: auto;
  }

  .logo-link {
    transition: opacity 0.2s ease;
  }

  .logo-link:hover {
    opacity: 0.75;
  }

  .site-nav {
    display: flex;
    gap: clamp(1.1rem, 3vw, 2.25rem);
  }

  .site-nav a {
    text-decoration: none;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.8rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-on-dark);
    padding-block: 0.35rem;
    border-bottom: 2px solid transparent;
    transition: border-color 0.2s ease, color 0.2s ease;
  }

  .site-nav a:hover,
  .site-nav a[aria-current='page'] {
    border-bottom-color: var(--color-on-dark);
  }

  .nav-toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 44px;
    height: 44px;
    padding: 10px;
    background: none;
    border: none;
    cursor: pointer;
  }

  .nav-toggle span {
    display: block;
    height: 2px;
    background: var(--color-on-dark);
    transition: transform 0.2s ease, opacity 0.2s ease;
  }

  /* Mobile */
  @media (max-width: 48rem) {
    .nav-toggle {
      display: flex;
    }

    .site-nav {
      display: none;
      position: absolute;
      inset-inline: 0;
      top: 100%;
      flex-direction: column;
      gap: 0;
      background: var(--color-dark);
      border-top: 1px solid var(--color-dark-soft);
    }

    .site-nav.is-open {
      display: flex;
    }

    .site-nav a {
      padding: 1rem var(--gutter);
      border-bottom: 1px solid var(--color-dark-soft);
    }

    .site-nav a:last-child {
      border-bottom: none;
    }

    .nav-toggle[aria-expanded='true'] span:nth-child(1) {
      transform: translateY(7px) rotate(45deg);
    }

    .nav-toggle[aria-expanded='true'] span:nth-child(2) {
      opacity: 0;
    }

    .nav-toggle[aria-expanded='true'] span:nth-child(3) {
      transform: translateY(-7px) rotate(-45deg);
    }
  }
</style>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.nav-toggle');
  const nav = document.getElementById('site-nav');

  toggle?.addEventListener('click', () => {
    const open = nav?.classList.toggle('is-open') ?? false;
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? 'Fermer le menu' : 'Ouvrir le menu');
  });
</script>
