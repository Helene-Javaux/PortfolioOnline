---
/**
 * Formulaire de contact — envoi via Web3Forms (https://web3forms.com),
 * 100 % côté client, aucun backend.
 *
 * ⚠️ La clé d'accès se configure dans src/config.ts (WEB3FORMS_CONTACT_KEY).
 */
import { WEB3FORMS_CONTACT_KEY } from '../config';
---

<form class="contact-form" id="contact-form" novalidate>
  <!-- Clé d'accès Web3Forms (placeholder à remplacer dans src/config.ts) -->
  <input type="hidden" name="access_key" value={WEB3FORMS_CONTACT_KEY} />
  <input type="hidden" name="subject" value="Nouveau message via helenejavaux.be" />
  <input type="hidden" name="from_name" value="Site helenejavaux.be" />
  <!-- Anti-spam (honeypot Web3Forms) -->
  <input type="checkbox" name="botcheck" class="visually-hidden" tabindex="-1" autocomplete="off" />

  <div class="field">
    <label for="cf-name">Nom</label>
    <input id="cf-name" type="text" name="name" required autocomplete="name" />
  </div>

  <div class="field">
    <label for="cf-email">E-mail</label>
    <input id="cf-email" type="email" name="email" required autocomplete="email" />
  </div>

  <div class="field">
    <label for="cf-type">Type de demande</label>
    <select id="cf-type" name="type_de_demande" required>
      <option value="" disabled selected>Choisir…</option>
      <option>Portrait</option>
      <option>Sport</option>
      <option>Packshot</option>
      <option>Événementiel</option>
      <option>Projet artistique / collaboration</option>
      <option>Autre</option>
    </select>
  </div>

  <div class="field">
    <label for="cf-message">Message</label>
    <textarea id="cf-message" name="message" rows="6" required></textarea>
  </div>

  <button class="btn" type="submit">Envoyer</button>

  <p class="form-status" role="status" aria-live="polite"></p>
</form>

<script>
  import { bindWeb3Form } from '../lib/web3form';

  bindWeb3Form(document.getElementById('contact-form') as HTMLFormElement);
</script>
