---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Format {
  label: string;
  price: string;
}

interface Props {
  title: string;
  reference: string;
  description?: string;
  photoImage: ImageMetadata;
  formats: Format[];
}

const { title, reference, description, photoImage, formats } = Astro.props;
---

<article class="print-card">
  <div class="print-card__media">
    <Image
      src={photoImage}
      alt={`Tirage « ${title} »`}
      width={800}
      widths={[400, 800]}
      sizes="(max-width: 40rem) 100vw, (max-width: 64rem) 50vw, 33vw"
      loading="lazy"
    />
  </div>

  <div class="print-card__body">
    <h3>{title}</h3>
    <p class="print-card__ref">Réf. {reference}</p>
    {description && <p class="print-card__desc">{description}</p>}

    <ul class="print-card__formats">
      {
        formats.map((format) => (
          <li>
            <span>{format.label}</span>
            <span class="print-card__price">{format.price}</span>
          </li>
        ))
      }
    </ul>

    <button
      class="btn btn--ghost print-card__cta"
      type="button"
      data-print-request
      data-reference={reference}
      data-title={title}
      data-formats={JSON.stringify(formats.map((f) => f.label))}
    >
      Demander ce tirage
    </button>
  </div>
</article>

<style>
  .print-card {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--color-line);
  }

  .print-card__media {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--color-paper-soft);
  }

  .print-card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .print-card__body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: 1.5rem;
  }

  .print-card__body h3 {
    margin-bottom: 0.15rem;
  }

  .print-card__ref {
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-muted);
    margin-bottom: 0.75rem;
  }

  .print-card__desc {
    font-size: 0.92rem;
    color: var(--color-muted);
  }

  .print-card__formats {
    list-style: none;
    margin: 0 0 1.25rem;
    padding: 0;
    flex: 1;
  }

  .print-card__formats li {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 0.45rem;
    border-bottom: 1px solid var(--color-line);
    font-size: 0.92rem;
  }

  .print-card__price {
    color: var(--color-ink);
    font-weight: 600;
  }

  .print-card__cta {
    align-self: flex-start;
  }
</style>
