---
/**
 * Lightbox plein écran pour les galeries.
 * À inclure UNE fois par page contenant un <PhotoGrid />.
 * Navigation : flèches (boutons + clavier), balayage tactile, Échap.
 */
---

<div class="lightbox" id="lightbox" hidden aria-modal="true" role="dialog" aria-label="Photo agrandie">
  <button class="lightbox__close" type="button" data-lb-close aria-label="Fermer">×</button>
  <button class="lightbox__nav lightbox__nav--prev" type="button" data-lb-prev aria-label="Photo précédente">‹</button>
  <figure class="lightbox__figure">
    <img id="lightbox-img" src="" alt="" />
  </figure>
  <button class="lightbox__nav lightbox__nav--next" type="button" data-lb-next aria-label="Photo suivante">›</button>
  <p class="lightbox__counter" id="lightbox-counter"></p>
</div>

<style>
  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(12, 12, 12, 0.96);
  }

  .lightbox[hidden] {
    display: none;
  }

  .lightbox__figure {
    margin: 0;
    max-width: min(92vw, 100rem);
    max-height: 88vh;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .lightbox__figure img {
    max-width: 100%;
    max-height: 88vh;
    width: auto;
    height: auto;
    box-shadow: 0 10px 60px rgba(0, 0, 0, 0.6);
    transition: opacity 0.3s ease;
  }

  @media (prefers-reduced-motion: reduce) {
    .lightbox__figure img {
      transition: none;
    }
  }

  .lightbox__close,
  .lightbox__nav {
    position: absolute;
    z-index: 101;
    background: none;
    border: none;
    color: #fff;
    cursor: pointer;
    font-family: var(--font-body);
    line-height: 1;
    padding: 0.5rem 1rem;
    opacity: 0.75;
    transition: opacity 0.15s ease;
  }

  .lightbox__close:hover,
  .lightbox__nav:hover {
    opacity: 1;
  }

  .lightbox__close {
    top: 1rem;
    right: 1rem;
    font-size: 2.25rem;
  }

  .lightbox__nav {
    top: 50%;
    transform: translateY(-50%);
    font-size: 3rem;
    padding: 1.5rem 1rem;
  }

  .lightbox__nav--prev {
    left: 0.5rem;
  }

  .lightbox__nav--next {
    right: 0.5rem;
  }

  .lightbox__counter {
    position: absolute;
    bottom: 1rem;
    left: 50%;
    transform: translateX(-50%);
    margin: 0;
    color: rgba(255, 255, 255, 0.7);
    font-size: 0.85rem;
    letter-spacing: 0.1em;
  }

  @media (max-width: 40rem) {
    .lightbox__nav {
      font-size: 2.25rem;
      padding: 1rem 0.6rem;
    }
  }
</style>

<script>
  const lightbox = document.getElementById('lightbox');
  const img = document.getElementById('lightbox-img') as HTMLImageElement | null;
  const counter = document.getElementById('lightbox-counter');
  const items = [...document.querySelectorAll<HTMLAnchorElement>('[data-lightbox]')];

  let current = 0;

  function show(index: number) {
    if (!lightbox || !img || items.length === 0) return;
    current = (index + items.length) % items.length;
    const item = items[current]!;
    // Transition douce entre les photos
    img.style.opacity = '0';
    img.onload = () => {
      img.style.opacity = '1';
    };
    img.src = item.dataset.full ?? item.href;
    img.alt = item.querySelector('img')?.alt ?? '';
    if (counter) counter.textContent = `${current + 1} / ${items.length}`;
    lightbox.hidden = false;
    document.body.style.overflow = 'hidden';
    // Préchargement des voisines
    for (const neighbor of [current + 1, current - 1]) {
      const n = items[(neighbor + items.length) % items.length];
      if (n?.dataset.full) new Image().src = n.dataset.full;
    }
  }

  function close() {
    if (!lightbox || !img) return;
    lightbox.hidden = true;
    img.src = '';
    document.body.style.overflow = '';
  }

  items.forEach((item, i) => {
    item.addEventListener('click', (event) => {
      event.preventDefault();
      show(i);
    });
  });

  lightbox?.querySelector('[data-lb-close]')?.addEventListener('click', close);
  lightbox?.querySelector('[data-lb-prev]')?.addEventListener('click', () => show(current - 1));
  lightbox?.querySelector('[data-lb-next]')?.addEventListener('click', () => show(current + 1));

  // Clic en dehors de l'image → fermer
  lightbox?.addEventListener('click', (event) => {
    const target = event.target as HTMLElement;
    if (target === lightbox || target.classList.contains('lightbox__figure')) close();
  });

  // Clavier
  document.addEventListener('keydown', (event) => {
    if (lightbox?.hidden !== false) return;
    if (event.key === 'Escape') close();
    if (event.key === 'ArrowLeft') show(current - 1);
    if (event.key === 'ArrowRight') show(current + 1);
  });

  // Balayage tactile
  let touchStartX = 0;
  lightbox?.addEventListener(
    'touchstart',
    (event) => {
      touchStartX = event.changedTouches[0]?.clientX ?? 0;
    },
    { passive: true },
  );
  lightbox?.addEventListener(
    'touchend',
    (event) => {
      const delta = (event.changedTouches[0]?.clientX ?? 0) - touchStartX;
      if (Math.abs(delta) > 50) show(delta > 0 ? current - 1 : current + 1);
    },
    { passive: true },
  );
</script>
