---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  href: string;
  title: string;
  subtitle?: string;
  cover: ImageMetadata;
  coverPosition?: string;
}

const { href, title, subtitle, cover, coverPosition } = Astro.props;
---

<a href={href} class="gallery-card">
  <div class="gallery-card__media">
    <Image
      src={cover}
      alt={title}
      width={800}
      widths={[400, 800]}
      sizes="(max-width: 40rem) 100vw, (max-width: 64rem) 50vw, 33vw"
      loading="lazy"
      style={coverPosition ? `object-position: ${coverPosition};` : undefined}
    />
  </div>
  <div class="gallery-card__caption">
    <span class="gallery-card__title">{title}</span>
    {subtitle && <span class="gallery-card__subtitle">{subtitle}</span>}
  </div>
</a>

<style>
  .gallery-card {
    display: block;
    text-decoration: none;
  }

  .gallery-card__media {
    overflow: hidden;
    aspect-ratio: 4 / 3;
    background: var(--color-paper-soft);
  }

  .gallery-card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease, opacity 0.3s ease;
  }

  .gallery-card:hover .gallery-card__media img,
  .gallery-card:focus-visible .gallery-card__media img {
    transform: scale(1.03);
    opacity: 0.92;
  }

  .gallery-card__caption {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
    padding-block: 0.85rem;
  }

  .gallery-card__title {
    font-family: var(--font-display);
    font-size: 1.3rem;
    color: var(--color-ink);
  }

  .gallery-card__subtitle {
    font-size: 0.8rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-muted);
  }
</style>