---
import { Image } from 'astro:assets';
import logo from '../assets/logo.svg';
import { SITE } from '../config';
import { url } from '../lib/url';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-inner">
    <div class="footer-brand">
      <a href={url('/')} aria-label="Accueil — Hélène Javaux">
        <Image src={logo} alt="Hélène Javaux" height={52} />
      </a>
      <p>Photographe — {SITE.location}</p>
    </div>

    <nav class="footer-nav" aria-label="Navigation pied de page">
      <a href={url('/portfolio/')}>Portfolio</a>
      <a href={url('/a-propos/')}>À propos</a>
      <a href={url('/tarifs/')}>Tarifs</a>
      <a href={url('/shop/')}>Shop</a>
      <a href={url('/contact/')}>Contact</a>
    </nav>

    <div class="footer-contact">
      <a href={SITE.instagram} target="_blank" rel="noopener">Instagram</a>
      <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
      <a href={SITE.phoneHref}>{SITE.phone}</a>
    </div>
  </div>

  <div class="container footer-legal">
    <p>© {year} Hélène Javaux. Toutes les photographies sont protégées par le droit d'auteur.</p>
    <a href={url('/conditions-generales-de-vente/')}>Conditions générales de vente</a>
  </div>
</footer>

<style>
  /* Bande sombre assortie au header */
  .site-footer {
    margin-top: clamp(3rem, 8vw, 6rem);
    background: var(--color-dark);
    color: var(--color-on-dark);
  }

  /* Les bandes CTA sombres collent directement au footer */
  :global(.cta-band) + .site-footer {
    margin-top: 0;
    border-top: 1px solid var(--color-dark-soft);
  }

  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: space-between;
    gap: 2rem;
    padding-block: 3rem 2rem;
  }

  .footer-brand img {
    height: 52px;
    width: auto;
  }

  .footer-brand p {
    margin: 0.75rem 0 0;
    font-size: 0.8rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-on-dark-muted);
  }

  .footer-nav,
  .footer-contact {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .footer-nav a,
  .footer-contact a {
    text-decoration: none;
    font-size: 0.85rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-on-dark-muted);
    transition: color 0.2s ease;
  }

  .footer-nav a:hover,
  .footer-contact a:hover {
    color: var(--color-on-dark);
  }

  .footer-legal {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 2rem;
    padding-block: 1.25rem;
    border-top: 1px solid var(--color-dark-soft);
  }

  .footer-legal p {
    margin: 0;
    font-size: 0.78rem;
    color: var(--color-on-dark-muted);
  }

  .footer-legal a {
    font-size: 0.78rem;
    color: var(--color-on-dark-muted);
  }

  .footer-legal a:hover {
    color: var(--color-on-dark);
  }

  @media (max-width: 48rem) {
    .footer-nav,
    .footer-contact {
      flex-direction: row;
      flex-wrap: wrap;
      gap: 1rem 1.25rem;
    }
  }
</style>
