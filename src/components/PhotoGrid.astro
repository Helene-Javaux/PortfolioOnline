---
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

/**
 * Grille de photos d'une galerie : la première photo s'affiche en grand
 * (image d'ouverture), les suivantes en grille libre qui respecte les
 * proportions. Chaque photo ouvre la lightbox (composant <Lightbox />
 * à inclure une fois sur la page).
 */
interface Props {
  photos: ImageMetadata[];
  /** Préfixe du texte alternatif, ex: "Wild Care" → "Wild Care — photo 3" */
  altPrefix: string;
}

const { photos, altPrefix } = Astro.props;

// Version grand format (lightbox) générée pour chaque photo
const fullSizes = await Promise.all(
  photos.map((p) =>
    getImage({ src: p, width: 1800, format: 'webp', quality: 80 }),
  ),
);

const [lead, ...rest] = photos;
---

{
  lead && (
    <a
      href={fullSizes[0]!.src}
      class="photo-lead"
      data-lightbox
      data-full={fullSizes[0]!.src}
      aria-label={`Agrandir : ${altPrefix} — photo 1 sur ${photos.length}`}
      data-reveal
    >
      <Image
        src={lead}
        alt={`${altPrefix} — photo 1`}
        width={1600}
        widths={[720, 1200, 1600]}
        sizes="(max-width: 76rem) 100vw, 1152px"
        loading="eager"
      />
    </a>
  )
}

<div class="photo-grid">
  {
    rest.map((photoSrc, i) => (
      <a
        href={fullSizes[i + 1]!.src}
        class="photo-grid__item"
        data-lightbox
        data-full={fullSizes[i + 1]!.src}
        aria-label={`Agrandir : ${altPrefix} — photo ${i + 2} sur ${photos.length}`}
        data-reveal
        style={`--reveal-delay: ${(i % 3) * 0.08}s`}
      >
        <Image
          src={photoSrc}
          alt={`${altPrefix} — photo ${i + 2}`}
          width={720}
          widths={[400, 720, 1000]}
          sizes="(max-width: 40rem) 100vw, (max-width: 64rem) 50vw, 33vw"
          loading="lazy"
        />
      </a>
    ))
  }
</div>

<style>
  .photo-lead {
    display: block;
    margin-bottom: 1.5rem;
  }

  .photo-lead img {
    width: 100%;
    height: auto;
    transition: opacity 0.25s ease;
  }

  /* Grille "masonry" : les photos gardent leurs proportions */
  .photo-grid {
    columns: 3 18rem;
    column-gap: 1.5rem;
  }

  .photo-grid__item {
    display: block;
    margin-bottom: 1.5rem;
    break-inside: avoid;
  }

  .photo-grid__item img {
    width: 100%;
    height: auto;
    transition: opacity 0.25s ease;
  }

  .photo-lead:hover img,
  .photo-lead:focus-visible img,
  .photo-grid__item:hover img,
  .photo-grid__item:focus-visible img {
    opacity: 0.88;
  }
</style>
