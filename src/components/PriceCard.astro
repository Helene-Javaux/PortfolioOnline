---
interface Props {
  title: string;
  subtitle?: string;
  halfDay: string;
  fullDay: string;
  includes: string[];
  note?: string;
}

const { title, subtitle, halfDay, fullDay, includes, note } = Astro.props;
---

<article class="price-card">
  <header>
    <h3>{title}</h3>
    {subtitle && <p class="price-card__subtitle">{subtitle}</p>}
  </header>

  <dl class="price-card__prices">
    <div>
      <dt>Demi-journée</dt>
      <dd>{halfDay}</dd>
    </div>
    <div>
      <dt>Journée</dt>
      <dd>{fullDay}</dd>
    </div>
  </dl>

  <ul class="price-card__includes">
    {includes.map((item) => <li>{item}</li>)}
  </ul>

  {note && <p class="price-card__note">{note}</p>}
</article>

<style>
  .price-card {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--color-line);
    padding: 2rem;
  }

  .price-card h3 {
    margin-bottom: 0.15rem;
  }

  .price-card__subtitle {
    font-size: 0.85rem;
    color: var(--color-muted);
    margin-bottom: 1.25rem;
  }

  .price-card__prices {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin: 0 0 1.5rem;
    padding-block: 1rem;
    border-block: 1px solid var(--color-line);
  }

  .price-card__prices dt {
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .price-card__prices dd {
    margin: 0.2rem 0 0;
    font-family: var(--font-display);
    font-size: 1.75rem;
    color: var(--color-ink);
  }

  .price-card__includes {
    list-style: none;
    margin: 0;
    padding: 0;
    flex: 1;
  }

  .price-card__includes li {
    position: relative;
    padding-left: 1.4rem;
    margin-bottom: 0.6rem;
    font-size: 0.95rem;
  }

  .price-card__includes li::before {
    content: '—';
    position: absolute;
    left: 0;
    color: var(--color-muted);
  }

  .price-card__note {
    margin: 1.25rem 0 0;
    font-size: 0.85rem;
    color: var(--color-muted);
    font-style: italic;
  }
</style>
